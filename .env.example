# Database (Neon). Leave empty to use local PGlite in .data/pglite
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Session signing secret (openssl rand -hex 32)
AUTH_SECRET=

# Gemini: OpenRouter key (LLM_PROVIDER=openrouter, model "google/gemini-…")
# or a Google AI Studio key (LLM_PROVIDER=gemini, GEMINI_API_KEY=…, model "gemini-…")
LLM_PROVIDER=openrouter
LLM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL_FAST=google/gemini-3.5-flash
GEMINI_MODEL_REASONING=google/gemini-3.5-flash
AI_DAILY_CALL_BUDGET=300
AI_MAX_OUTPUT_TOKENS=1500

# Push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:<owner-contact>

# Scheduler: shared secret for /api/cron/* (GitHub Actions + Vercel Cron)
CRON_SECRET=
APP_URL=http://localhost:3000
# Comma-separated user_ref values allowed on /admin. Empty = nobody on Vercel (fail closed); local dev stays open.
ADMIN_USER_REFS=
